# Tower: /boot/config/plugins/compose.manager/projects/cna/.env, chmod 600, owned by root.
# Hex keeps the password safe inside DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# The Discord application "Campaign for North Africa" (OAuth2 page).
CNA_DISCORD_CLIENT_ID=
CNA_DISCORD_CLIENT_SECRET=
# Its bot (Bot page) and the "CNA" server it lives in. Both empty = no turn alerts.
CNA_DISCORD_BOT_TOKEN=
CNA_DISCORD_GUILD_ID=
# Comma-separated Discord user ids of the admins.
CNA_ADMINS=
# Optional: defaults to https://cna.basmith.net
# CNA_PUBLIC_URL=
